# Unsloth Studio —— 开机自启的用户级 service（发布版）
#   安装并启动: systemctl --user daemon-reload && systemctl --user enable --now unsloth-studio
#   日志:       journalctl --user -u unsloth-studio -f
#   访问:       http://127.0.0.1:8888
# 开机自启依赖 Linger：loginctl enable-linger "$USER"
#   验证:       loginctl show-user "$USER" | grep Linger  →  Linger=yes
#
# 本文件中 %h 由 systemd 展开为你的 home 目录；模型/HF 缓存路径请按自己机器改。

[Unit]
Description=Unsloth Studio (local LLM web UI + OpenAI-compatible API on :8888)
Documentation=https://docs.unsloth.ai/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 关键：studio 用相对路径 "./models" 扫描本地模型
#   studio/backend/hub/services/models/local_inventory.py:1656
#   studio/backend/routes/models.py:1320   allowed_roots = [Path("./models").resolve(), hf_cache_dir]
# 该目录不存在时，前端 "refresh local models" 直接 500
# (FileNotFoundError: [Errno 2] No such file or directory)。
# 所以 WorkingDirectory 必须落在含 models/ 的目录；指到 ~/AI 后 ./models 就是真实模型目录
# %h/AI/models。改这里前先确认 <WorkingDirectory>/models 存在。
WorkingDirectory=%h/AI

ExecStart=%h/.unsloth/studio/unsloth_studio/bin/unsloth studio --port 8888 --host 127.0.0.1

Environment=PATH=%h/.unsloth/studio/unsloth_studio/bin:/usr/local/bin:/usr/bin:/bin
# HF 缓存在 ~/AI/huggingface（不是默认的 ~/.cache/huggingface）。不设这个，studio 扫不到已下载的模型。
Environment=HF_HOME=%h/AI/huggingface
# 与交互终端环境保持一致（~/.zshenv 里导出过）
Environment=UNSLOTH_NO_TORCH=1
# AMD/ROCm 主机
Environment=VLLM_TARGET_DEVICE=rocm

Restart=on-failure
RestartSec=10
# 停止时 studio 要收掉自己拉起的 llama-server 子进程，给足时间（超时后 cgroup 会被 SIGKILL 兜底）
TimeoutStopSec=45

# 内存硬上限：整机 62 GiB，留 ~12 GiB 给系统。曾发生该单元里的 llama-server
# 涨到 ~48 GB（anon 35 GB + shmem 13.7 GB）触发全局 OOM：整机僵死数十秒、
# 关键监控进程被饿住产生误报，llama-server 反被内核杀了 3 次。
# 设上限后超限的 OOM 只发生在本单元内部（Restart=on-failure 会拉回来），
# 不再拖垮整台机器。
# 整机内存不同的话请按 “总内存 - 系统预留” 换算；改完需要自行
# systemctl --user restart unsloth-studio 才生效。
MemoryMax=50G

NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unsloth-studio

[Install]
WantedBy=default.target
